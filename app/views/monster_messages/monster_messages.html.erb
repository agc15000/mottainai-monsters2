<h1>メッセージ一覧</h1>#ここから
<%= form_with url: user_monster_messages_path(@user), method: :get do |form| %>
  <%= form.select :conversation_id, @conversations.map { |c| [c.user_monster.monster.name, c.id] }, { selected: params[:conversation_id] } %>
  <%= form.submit '選択' %>
<% end %>#ここまでいらないのでは？（ユーザーモンスター一覧で選択するし）

#ユーザーモンスター一覧で選択した情報をもとにモンスターとユーザーの情報を表示（@monster_messagesにメッセージを格納）
<% @monster_messages.each do |monster_message| %>
  <p>
    <strong><%= monster_message.sender_type == 'monster' ? monster_message.conversation.user_monster.monster.name : 'あなた' %>:</strong> <%= monster_message.content %>
  </p>
<% end %>

<h2>メッセージを送信する</h2>#ユーザーモンスター一覧で選択したモンスター宛にメッセージを送信

<%= form_with model: @new_monster_message, url: user_monster_messages_path(@user) do |form| %>
  <%= form.hidden_field :conversation_id, value: params[:conversation_id] %>
  <%= form.text_area :content %>
  <%= form.submit '送信' %>
<% end %>